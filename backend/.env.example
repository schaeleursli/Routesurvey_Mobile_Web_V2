DATABASE_URL=postgresql+asyncpg://postgres:supabase_password@localhost:54322/postgres
ENVIRONMENT=development
DEBUG=true

# Must match the JWT secret used by the existing RouteSurvey authentication backend.
ROUTESURVEY_JWT_SECRET=change-me-in-env
ROUTESURVEY_JWT_ALGORITHM=HS256

# JSON list of RouteSurvey user IDs allowed to administer CRM when the JWT has no admin role claim.
CRM_ADMIN_SUBJECTS=[]

# Optional. Defaults include localhost Vite URLs.
# CORS_ORIGINS=["http://localhost:5173"]
